# Compose
COMPOSE_PROJECT_NAME=aquila-office

# PostgreSQL
POSTGRES_DB=aquila_office
POSTGRES_USER=aquila
POSTGRES_PASSWORD=change_me_before_prod
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
BACKEND_PORT=8080
CUSTOM_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Nginx
NGINX_HTTP_PORT=80
