# Compose
COMPOSE_PROJECT_NAME=aquila-office

# PostgreSQL
POSTGRES_DB=aquila_office
POSTGRES_USER=aquila
POSTGRES_PASSWORD=change_me_before_prod
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update
BACKEND_PORT=8080
CUSTOM_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost
AQUILA_AUTH_TOKEN_ISSUER=aquila-office
AQUILA_AUTH_TOKEN_SECRET=change_me_to_at_least_32_bytes_before_prod
AQUILA_AUTH_ACCESS_TOKEN_TTL=15m
AQUILA_AUTH_REFRESH_TOKEN_TTL=14d
AQUILA_GOOGLE_OAUTH_CLIENT_IDS=google-client-id.apps.googleusercontent.com
AQUILA_GOOGLE_ALLOWED_HOSTED_DOMAINS=
AQUILA_GOOGLE_REQUIRE_EMAIL_VERIFIED=true
AQUILA_GOOGLE_APPLICATION_NAME=aquila-office
AQUILA_EXTERNAL_TOKEN_KEY=change_me_to_at_least_32_bytes_before_prod
AQUILA_EXTERNAL_TOKEN_KEY_ID=prod
AQUILA_GATEWAY_RPC_REQUEST_TIMEOUT=30s
AQUILA_GATEWAY_RPC_PATH=/rpc

# SMTP / invite email
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
AQUILA_INVITE_EMAIL_ENABLED=false
AQUILA_INVITE_EMAIL_FROM=noreply@aquila-office.local
AQUILA_INVITE_ACCEPT_URL_BASE=http://localhost:3000/invites/accept

# Vertex AI
# Compose mounts the ignored local key file into GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT_ID=grepp-ai-project
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_CREDENTIALS_HOST_PATH=./vertex-key.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-key.json

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nginx
NGINX_HTTP_PORT=80
