# OCI A1 staging environment.
# Copy this to the repository root as `.env.oci-a1-staging` and fill real values locally.
# The local file is ignored and must not be committed.

OCI_A1_SSH_HOST=
OCI_A1_SSH_PORT=22
OCI_A1_SSH_USER=ubuntu
OCI_A1_SSH_PRIVATE_KEY_B64=
OCI_A1_SSH_KNOWN_HOSTS_B64=

OCI_A1_BACKEND_ENV_B64=
OCI_A1_FRONTEND_ENV_B64=

STAGING_BASE_URL=
STAGING_PUBLIC_API_BASE_URL=
STAGING_OCI_A1_DATABASE_URL=

STAGING_SMOKE_HEALTH_PATH=/actuator/health
STAGING_SMOKE_READ_PATH=
STAGING_SMOKE_WRITE_METHOD=POST
STAGING_SMOKE_WRITE_PATH=
STAGING_SMOKE_WRITE_BODY=
STAGING_SMOKE_AUTH_HEADER_NAME=Authorization
STAGING_SMOKE_AUTH_HEADER_VALUE=

STAGING_REPLAY_TOKEN=
STAGING_REPLAY_LOGIN_ID=
STAGING_REPLAY_USER_ID=
STAGING_REPLAY_USER_DISPLAY_NAME=
STAGING_REPLAY_USER_PASSWORD_HASH=
STAGING_REPLAY_HOT_ACCOUNT_ID=
STAGING_REPLAY_HOT_ACCOUNT_NUMBER=
STAGING_REPLAY_HOT_FROM=
STAGING_REPLAY_HOT_TO=
STAGING_REPLAY_HOT_P95_THRESHOLD_MS=
STAGING_REPLAY_COLD_ACCOUNT_ID=
STAGING_REPLAY_COLD_ACCOUNT_NUMBER=
STAGING_REPLAY_COLD_FROM=
STAGING_REPLAY_COLD_TO=
STAGING_REPLAY_COLD_P95_THRESHOLD_MS=
STAGING_REPLAY_EXPECTED_TOTAL_ROWS=
STAGING_REPLAY_ITERATIONS=
STAGING_REPLAY_PAGE_LIMIT=
STAGING_REPLAY_REQUEST_TIMEOUT_SECONDS=
STAGING_REPLAY_STATS_MAX_AGE_HOURS=
STAGING_REPLAY_STATS_MAX_MODIFIED_RATIO=

ALERTMANAGER_RECEIVER_SLACK_ENABLED=false
ALERTMANAGER_RECEIVER_PAGERDUTY_ENABLED=false
ALERTMANAGER_RECEIVER_WEBHOOK_ENABLED=false
ALERTMANAGER_RECEIVER_WEBHOOK_URL=
