{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aquila Office",
  "mainBinaryName": "AquilaOffice",
  "version": "0.1.0",
  "identifier": "com.aquila.office",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aquila Office",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' https://accounts.google.com"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "licenseFile": "../../LICENSE",
    "publisher": "Aquila Office",
    "copyright": "Copyright 2026 Aquila Office Contributors. Apache License 2.0.",
    "category": "Productivity",
    "shortDescription": "Collaborative AI agent workspace platform",
    "longDescription": "Aquila Office is a collaborative AI agent workspace desktop and web application with a 2D virtual office, task orchestration, agent chat, artifact viewer, and OS integration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libdbus-1-3",
          "libxdo3",
          "libssl3"
        ],
        "recommends": [
          "libayatana-appindicator3-1 | libappindicator3-1",
          "xdg-utils"
        ],
        "desktopTemplate": "./linux/aquila-office.desktop"
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libxdo.so.3()(64bit)",
          "libssl.so.3()(64bit)"
        ],
        "desktopTemplate": "./linux/aquila-office.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
